# Only needed for the optional model-in-the-loop eval (npm run eval:model).
ANTHROPIC_API_KEY=

# Model used by npm run eval:model.
EVAL_MODEL=claude-sonnet-5-5

# Optional. Override where the databases live. Defaults are data/warehouse.db and data/state.db.
# WAREHOUSE_DB=/absolute/path/warehouse.db
# STATE_DB=/absolute/path/state.db

{
  "name": "marketing-analyst-mcp",
  "version": "0.1.0",
  "description": "Example MCP server that answers marketing performance questions through governed metrics. Synthetic data, fictional business.",
  "license": "MIT",
  "author": "Mert Atalay",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build:db": "node src/cli/build-db.ts",
    "start": "node src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"tests/*.test.ts\"",
    "eval": "node evals/run-deterministic.ts",
    "eval:model": "node --env-file-if-exists=.env evals/run-model.ts",
    "approve": "node src/cli/decide.ts approve",
    "reject": "node src/cli/decide.ts reject",
    "proposals": "node src/cli/decide.ts list"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.13.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  }
}
